# Copy to .env (which is gitignored) and fill in. Never commit real keys.
# Read by the LLM client (src/migration_agent/llm/client.py); empty means the default.

# API key for Claude. Empty: ANTHROPIC_API_KEY or an `ant auth login` profile is used.
LLM_API_KEY=
# Only for a proxy or gateway; empty means Anthropic's API.
LLM_BASE_URL=
# Default: claude-opus-5-5
LLM_MODEL=
# low | medium | high | xhigh | max, or none for a model without effort. Default: high
LLM_EFFORT=
# Longest reply in tokens. Default: 16000
LLM_MAX_TOKENS=
